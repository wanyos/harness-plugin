{
  "description": "Hooks del harness: reglas comunes al arrancar la sesión y cada subagente; verificación rápida tras cada lote de herramientas que toca código; verificación completa cuando termina el implementer",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/inyectar-reglas.sh\" SessionStart reglas-comunes-1.md"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/inyectar-reglas.sh\" SessionStart reglas-comunes-2.md"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/inyectar-reglas.sh\" SubagentStart reglas-comunes-1.md"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/inyectar-reglas.sh\" SubagentStart reglas-comunes-2.md"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/verify-changed.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^harness:implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/verify-full.sh\""
          }
        ]
      }
    ]
  }
}
